# Non-secret configuration only. Replace with the sole authorized repository.
GH_REPO=owner/repository
# Supported agents: codex or claude. CLI authentication is managed separately.
AGENT=codex
# Codex only: read-only, workspace-write (default), or danger-full-access.
# Full access disables the Codex sandbox; use only with external isolation.
AGENT_SANDBOX=workspace-write
TASK_LABEL=codex-task
IN_PROGRESS_LABEL=in-progress
# Positive integers; timeout is the total task budget in minutes.
MAX_MINUTES=120
POLL_SECONDS=60
# Bounded concurrent tasks; defaults to one task at a time.
MAX_CONCURRENT_TASKS=1
# Absolute path, writable by agent; contains clones, locks and logs.
WORK_ROOT=/home/agent/data/tasks
# Legacy Python worker option; ignored by the Go worker.
AGENT_TMUX=0
# The Go worker always runs continuously; see docs/operations.md before starting.
