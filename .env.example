# Non-secret configuration only. Replace with the sole authorized repository.
GH_REPO=owner/repository
# Supported agents: codex or claude. CLI authentication is managed separately.
AGENT=codex
TASK_LABEL=codex-task
IN_PROGRESS_LABEL=in-progress
# Positive integers; timeout is the total task budget in minutes.
MAX_MINUTES=120
POLL_SECONDS=60
# Absolute path, writable by agent; contains clones, locks and logs.
WORK_ROOT=/home/agent/data/tasks
# Opt in to a live tmux pane with 1; requires tmux in the service PATH.
AGENT_TMUX=0
# Execution is selected by CLI flags, not an environment variable.
# The packaged service uses --dry-run; see docs/operations.md for --execute.
